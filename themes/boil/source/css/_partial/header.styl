#header
  height: banner-height
  position: relative
  border-bottom: 1px solid color-border
  &:before, &:after
    content: ""
    position: absolute
    left: 0
    right: 0
    height: 40px
  &:before
    top: 0
    background: linear-gradient(rgba(0, 0, 0, 0.2), transparent)
  &:after
    bottom: 0
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.2))

#header-outer
  height: 100%
  max-width: 100%
  position: relative
  background: #0000007d
  padding: 0 25px
  // margin: 0 10px

.header-flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

#header-btn {
  display: inline-block
  padding: 12px 25px
  font-size: 16px
  font-weight: bold
  background-color: #00000025
  color: #fff
  border: 2px solid #ffffff
  border-radius: 10px
  cursor: pointer
  // margin-right: 30px
  text-decoration: none
  transition: background 0.3s
}

#header-btn:hover {
  background: #FE502593;
}

@media mq-mobile
  #header-title
    flex-direction: column
    align-items: flex-start
    height: auto
    position relative
    top: 0
    margin-top: 30px

  #header-btn
    width: max-content
    margin: 10px 0 0 0
    font-size: 14px
    text-align: center




#header-inner
  position: relative
  overflow: hidden
  @media mq-normal
    top: 30px;

#banner
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: url(banner-url) center #000
  background-size: cover
  z-index: -1

#header-title  
  text-align: left
  height: logo-size
  position: absolute
  top: 50%
  left: 0
  margin-top: 0

  @media mq-mobile
    margin: 0 25px;
    margin-top: -70px 
    width: 90%;

$logo-text
  text-decoration: none
  color: #fe5025
  font-weight: bold
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3)

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  font-family: arial
  line-height: subtitle-size
  letter-spacing: 1px
  color: #ffffff
  font-weight: 300

#logo
  @extend $logo-text
  font-family: Roboto
  font-size: 5vw
  font-weight: bold
  line-height: 45px
  letter-spacing: 2px
  @media mq-mobile
    font-size: 42px
    line-height: 42px

#subtitle-wrap
  // margin-bottom: 12px

#main-nav
  float: left
  margin-left: -15px

$nav-link
  float: left
  color: #fff
  opacity: 0.6
  text-decoration: none
  text-shadow: 0 1px rgba(0, 0, 0, 0.2)
  transition: opacity 0.2s
  display: block
  padding: 20px 15px
  &:hover
    opacity: 1

.nav-icon
  @extend $nav-link
  text-align: center
  font-size: font-size
  width: font-size
  height: font-size
  padding: 20px 15px
  position: relative
  cursor: pointer

.main-nav-link
  @extend $nav-link
  font-weight: 300
  letter-spacing: 1px
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px

#search-form-wrap
  position: absolute
  top: 15px
  width: 150px
  height: 30px
  right: -150px
  opacity: 0
  transition: 0.2s ease-out
  &.on
    opacity: 1
    right: 0
  @media mq-mobile
    width: 100%
    right: -100%

.search-form
  position: absolute
  top: 0
  left: 0
  right: 0
  background: #fff
  padding: 5px 15px
  border-radius: 15px
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3)

.search-form-input
  border: none
  background: none
  color: color-default
  width: 100%
  font: 13px font-sans
  outline: none
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 10px
  margin-top: -7px
  font: 13px font-icon
  border: none
  background: none
  color: #bbb
  cursor: pointer
  &:hover, &:focus
    color: #777