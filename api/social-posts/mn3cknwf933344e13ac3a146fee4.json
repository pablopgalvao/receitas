  "ingredients": [
    "4 bananas-da-terra maduras",
    "Suco de 1 limão",
    "1 colher de sopa de manteiga",
    "1 cebola picada",
    "Sal e pimenta-do-reino a gosto"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Descasque as bananas, corte-as em rodelas, e esprema o limão sobre elas para que não escureçam;",
    "Leve uma panela ao fogo baixo, derreta a manteiga, e refogue a cebola;",
    "Acrescente as bananas, misture, tampe a panela, e deixe-as cozinhar por 5 minutos;",
    "Amasse-as com as mãos ou com a ajuda de um mixer ou liquidificador, tempere o purê com sal e pimenta, e sirva na sequência."
  ],
