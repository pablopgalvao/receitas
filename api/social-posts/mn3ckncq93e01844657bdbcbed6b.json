  "ingredients": [
    "1 caixinha de morangos",
    "½ xícara de chá de açúcar",
    "½ limão"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Lave bem os moranguinhos, retire o cabo e corte em pedaços menores;",
    "Coloque em uma panela e adicione o açúcar e o suco de limão;",
    "Leve para cozinhar em fogo baixo e mexa por vezes;",
    "Assim que der o ponto de geleia já pode desligar o fogo;",
    "Sirva e bom apetite!"
