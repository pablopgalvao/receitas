  "ingredients": [
    "3 colheres de sopa de óleo",
    "3 dentes de alho amassados",
    "1 cebola grande picada",
    "1 pimentão picado",
    "4 tomates sem sementes picados",
    "Sal a gosto",
    "Cheiro-verde a gosto",
    "400 gramas de molho de tomate",
    "2 latas de milho-verde",
    "1 kg de salsicha (picada ou inteira, como preferir)"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Coloque o óleo em uma panela e refogue o alho e a cebola;",
    "Acrescente o pimentão, os tomates, o sal, o cheio-verde, misture e deixe ferver por cerca de 5 minutos;",
    "Adicione o molho de tomate, o milho e as salsichas, misture e deixe cozinhar por cerca de 10 minutos;",
    "Agora é só servir. Bom apetite!"
  ],
