  "ingredients": [
    "800 g de batata-doce",
    "1 colher de chá de sal",
    "1 colher de sopa de tomilho seco",
    "Pimenta-do-reino a gosto",
    "3 colheres de sopa de azeite",
    "Tomilho fresco a gosto"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Higienize as batatas, descasque-as e corte-as em rodelas de cerca de 1 cm;",
    "Transfira as batatas para uma assadeira e tempere-as com sal, tomilho seco, pimenta e azeite. Em seguida, asse-as forno pré-aquecido a 200º graus, por cerca de 20 minutos;",
    "Finalize salpicando tomilho fresco sobre as batatas."
