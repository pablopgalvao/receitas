  "ingredients": [
    "2 filés de tilápia",
    "Sal a gosto",
    "Pimenta em pó a gosto",
    "2 dentes de alho amassados",
    "1 fio de azeite de oliva",
    "Limão a gosto"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Em um recipiente, tempere o peixe com sal, azeite, pimenta, alho e limão;",
    "Mexa bem e deixe os filés absorverem o tempero por cerca de 5 minutos;",
    "Acomode os filés na cestinha da air fryer;",
    "Pré-aqueça a fritadeira elétrica a 180 °C e frite o peixe por cerca de 20 minutos;",
    "Agora é só servir! Bom apetite."
