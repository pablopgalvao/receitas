  "ingredients": [
    "800 ml de leite",
    "50 g de açúcar (demerara ou cristal)",
    "150 g de arroz de risoto",
    "200 ml de leite de coco",
    "50 g de chocolate amargo picado"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Ferva o leite e reserve;",
    "Leve uma panela ao fogo médio, adicione o açúcar e espere caramelizar;",
    "Quando caramelizar, acrescente o arroz e misture;",
    "Junte o leite quente, e deixe o arroz cozinhar até ficar bem mole;",
    "Desligue o fogo, adicione o leite de coco, o chocolate e misture;",
    "Transfira o arroz doce para um refratário (ou divida-o em porções individuais), leve-o à geladeira, e sirva quando estiver gelado."
  ],
