  "ingredients": [
    "⅓ de xícara (chá) de azeite",
    "1 xícara (chá) de bacon picado",
    "1 cebola picada",
    "1 lata de milho verde escorrido",
    "½ lata de ervilha escorrida",
    "½ pimenta vermelha sem sementes picada",
    "3 xícaras (chá) de farinha de milho",
    "sal a gosto"
  ],
  "steps": [
    "Aqueça uma panela com metade do azeite, em fogo médio, frite o bacon e a cebola até dourar.",
    "Adicione o milho, a ervilha, a pimenta e refogue por 2 minutos.",
    "Acrescente a farinha, sal, misture e desligue o fogo. Sirva."
  ],
