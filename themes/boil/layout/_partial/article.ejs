<article id="<%= post.layout %>-<%= post.slug %>" class="h-entry article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <!-- <div class="article-meta">
    <%- partial('post/category') %>
  </div> -->
  <div class="article-inner <%= index ? 'card-home' : 'card-geral' %>">
     <% if (post.link || post.title){ %>
      <header class="article-header">
        <%- partial('post/title', {class_name: 'p-name article-title'}) %>
      </header>
      <% } %>
      <% if (index){ %>
        <%- partial('post/gallery') %>
        <div class="card-meta">
          <% var recipeTime = post.time; %>
          <% var recipeDifficulty = post.difficulty || post.dificuldade; %>
          <% var recipeServings = post.servings || post.serves || post.rendimento; %>
          <% if (recipeTime){ %>
            <div class="card-meta-item">
              <span class="card-meta-label">Tempo:</span>
              <span class="card-meta-value"><%= recipeTime %></span>
            </div>
          <% } %>
          <% if (recipeDifficulty){ %>
            <div class="card-meta-item">
              <span class="card-meta-label">Dificuldade:</span>
              <span class="card-meta-value"><%= recipeDifficulty %></span>
            </div>
          <% } %>
          <% if (recipeServings){ %>
            <div class="card-meta-item">
              <span class="card-meta-label">Serve:</span>
              <span class="card-meta-value"><%= recipeServings %></span>
            </div>
          <% } %>
          <% if (post.categories && post.categories.length){ %>
            <div class="card-meta-item card-meta-category">
              <!-- <span class="card-meta-label">Categoria:</span> -->
              <span class="card-meta-value">
                <%- list_categories(post.categories, {
                  show_count: false,
                  class: 'card-meta-category-list',
                  style: 'none',
                  separator: ', '
                }) %>
              </span>
            </div>
          <% } %>
        </div>
      <% } %>
    <% if (!index){ %>
      <div class="e-content article-entry" itemprop="articleBody">
        <%- post.content %>
      </div>
      <footer class="article-footer">
        <% if (post.comments && theme.disqus_shortname){ %>
          <a href="<%- post.permalink %>#disqus_thread" class="article-comment-link"><span class="fa fa-comment"><%= __('comment') %></span></a>
        <% } %>
        <% if (post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey ){ %>
          <a href="<%- url_for(post.path) %>#comments" class="article-comment-link">
            <span class="post-comments-count valine-comment-count fa fa-comment" data-xid="<%- url_for(post.path) %>" itemprop="commentCount"></span>
            <%= __('comment') %>
          </a>
        <% } %>
        <%- partial('post/tag') %>
      </footer>
    <% } %>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments && theme.disqus_shortname){ %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
<% if (!index && post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey){ %>
  <section id="comments" class="vcomment">

  </section>
<% } %>