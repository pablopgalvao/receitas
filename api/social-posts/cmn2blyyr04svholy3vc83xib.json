  "ingredients": [
    "1 kg de filé de frango (sassami)",
    "Sal a gosto",
    "2 colheres de sopa de óleo",
    "Açafrão a gosto",
    "4 ovos",
    "Farinha Panko para empanar",
    "Pimenta-do-reino a gosto",
    "2 colheres de sopa de caldo de galinha em pó"
  ],
  "steps": [
    "Reúna todos os ingredientes;",
    "Corte o frango em tiras e reserve em um refratário;",
    "Tempere com o sal e a pimenta-do-reino;",
    "Adicione o açafrão e o caldo de galinha em pó. Misture bem;",
    "Bata os ovos levemente. Reserve;",
    "Passe o frango nos ovos batidos e, em seguida, empane com a farinha Panko;",
    "Pincele as tiras com óleo e leve para assar na air fryer a 200 ºC por cerca de 15 minutos;",
    "Sirva e bom apetite!"
